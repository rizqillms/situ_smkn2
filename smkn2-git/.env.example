# Copy this file to .env for local development. Never commit real values.
# server.js memuat file .env otomatis melalui dotenv.
NODE_ENV=development
PORT=3000
# Keep operational data outside the source tree. Relative paths follow the process working directory.
DATA_DIR=./runtime-data
# Used only when creating the first administrator in an empty database.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-chars
# Set to 1 only when the app is behind exactly one trusted reverse proxy.
# TRUST_PROXY_HOPS=1
